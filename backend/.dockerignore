# Keep secrets and local state out of the image.
.env
.env.*
!.env.example

# Installed inside the image by composer install.
vendor/

# Not needed at runtime.
tests/
phpunit.xml
.phpunit.cache/
.phpunit.result.cache
.editorconfig
.gitattributes
Dockerfile
.dockerignore

# Local runtime files: the container creates its own.
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php
